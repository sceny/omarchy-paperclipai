{
  "repository": "sceny/omarchy-paperclipai",
  "twin": "sceny/omarchy-devices",
  "environment": {
    "check": "public-text-environment",
    "patterns": [
      {
        "id": "sandbox-tool",
        "regex": "\\bdev/(?:sandbox|rig)\\b",
        "allowed_when_changed": [
          "dev/sandbox*",
          "dev/rig*",
          "docs/internals/development.md",
          "test/test_sandbox.py"
        ],
        "quoted": true
      },
      {
        "id": "sandbox",
        "regex": "\\bsandbox(?:es)?\\b",
        "allowed_when_changed": [
          "dev/sandbox*",
          "dev/rig*",
          "docs/internals/development.md",
          "test/test_sandbox.py"
        ],
        "quoted": true,
        "unless_near": "decod\\w*\\s+(?:only\\s+|(?:happens|runs)\\s+)?(?:in|with|by|inside|within|via|through)\\s+(?:the\\s+|an?\\s+|its\\s+(?:own\\s+)?|own\\s+)?sandbox(?:es)?\\b|bubblewrap|glycin|pixbuf|ffmpeg|\\b(?:no|without|around|outside|bypass\\w*)\\s+(?:the\\s+|a\\s+)?sandbox"
      },
      {
        "id": "rig",
        "regex": "\\brigs?\\b",
        "allowed_when_changed": [
          "dev/sandbox*",
          "dev/rig*",
          "docs/internals/development.md",
          "test/test_sandbox.py"
        ],
        "quoted": true
      },
      {
        "id": "emulator",
        "regex": "\\bemulat(?:or|ors|ed)\\b",
        "allowed_when_changed": [
          "dev/sandbox*",
          "dev/rig*",
          "docs/internals/development.md",
          "test/test_sandbox.py"
        ],
        "quoted": true
      },
      {
        "id": "podman",
        "regex": "\\bpodman\\b",
        "allowed_when_changed": [
          "dev/sandbox*",
          "dev/rig*",
          "docs/internals/development.md",
          "test/test_sandbox.py"
        ],
        "quoted": true
      },
      {
        "id": "container",
        "regex": "\\b(?:in|inside|into|within|using|via|start(?:ed|s|ing)?|ran|run(?:s|ning)?|launch(?:ed|es|ing)?|spun|spin(?:s|ning)?|built|build(?:s|ing)?|creat(?:e|ed|es|ing)|boot(?:ed|s|ing)?)\\s+(?:\\w+\\s+){0,2}containers?\\b|\\b(?:new|fresh|throwaway|rootless|disposable|podman|docker|sandbox|separate|clean|another)\\s+containers?\\b|\\bcontainers?\\s+(?:image|runtime|runs?|starts?|started|stopped|exits?)\\b",
        "allowed_when_changed": [
          "dev/sandbox*",
          "dev/rig*",
          "docs/internals/development.md",
          "test/test_sandbox.py"
        ],
        "quoted": true,
        "unless_near": "\\bqml\\b|\\bitem\\b|layout|\\brow\\b|\\bcolumn\\b|flickable|rectangle|scroll|\\.qml|\\bcards?\\b|\\btiles?\\b|\\bgrid\\b|\\bcells?\\b|\\bwidgets?\\b|\\bpills?\\b|\\bsections?\\b"
      },
      {
        "id": "paperclip",
        "regex": "\\bpaperclip\\s+(?:task|board|ticket|heartbeat)s?\\b",
        "quoted": true
      },
      {
        "id": "task-id",
        "regex": "\\bSCE-\\d+\\b",
        "quoted": true
      },
      {
        "id": "home-path",
        "regex": "(?<![\\w])/home/[^\\s`)\\]]*",
        "unless_match": "omarchy/paperclipai|sceny\\.paperclipai"
      },
      {
        "id": "dot-path",
        "regex": "(?<![\\w])~/\\.[^\\s`)\\]]*",
        "unless_match": "omarchy/paperclipai|sceny\\.paperclipai"
      },
      {
        "id": "tmp-path",
        "regex": "(?<![\\w.])/tmp/[^\\s`)\\]]*"
      },
      {
        "id": "runtime-dir",
        "regex": "\\$\\{?XDG_RUNTIME_DIR\\}?[^\\s`)\\]]*",
        "unless_match": "omarchy/paperclipai|sceny\\.paperclipai"
      },
      {
        "id": "test-count-passed",
        "regex": "\\b\\d+\\s+(?:tests?\\s+)?(?:passed|passing)\\b|\\b(?:passed|passing)\\s+\\d+\\b|\\b\\d+\\s*/\\s*\\d+\\s+(?:tests?\\s+)?(?:passed|pass|green)\\b"
      },
      {
        "id": "test-tally",
        "regex": "\\b\\d+\\s+(?:tests?\\s+)?(?:pass|fail(?:ed|ures?)?)\\b(?!-)(?!\\s+in\\s+a\\s+row\\b)(?!\\s+(?!(?:and|or|on|in|of|out|with|at|after|before|since|so|but|here|now|locally|then|again|tests?)\\b)[a-z])",
        "unless_before": "\\b(?:version|release|step|stage|phase|part|round|attempt|try|android|api|level|sdk|omarchy|qt|python|node|hyprland)\\s*$"
      },
      {
        "id": "test-count",
        "regex": "\\b\\d+\\)?\\s+(?:(?:unit|node|python|bridge|model)\\s+)?tests?\\b(?!/)|\\b(?:ran|run|runs|running)\\s+\\d+\\s+(?:unit\\s+)?tests?\\b|\\bOK \\(\\d+ tests?\\)",
        "unless_before": "\\b(?:adds?|added|adding|introduc(?:es?|ed|ing)|includes?|including|writes?|wrote)\\s+(?:(?!(?:and|or|but|nor|then|plus|so|while|ran|run|runs|running|pass|passes|passed|passing)\\b)\\w+\\s+){0,3}$"
      },
      {
        "id": "own-machine",
        "regex": "\\b(?:check(?:ed|s)?|test(?:ed|s)?|ran|runs?|running|works?|worked|verified|reproduc\\w*|tried|built|pass(?:es|ed)?|fail(?:s|ed)?)\\b[^.;:!?\\n]{0,60}?\\bthis\\s+(?:machine|host)\\b|\\bthis\\s+(?:machine|host)\\b[^.;:!?\\n]{0,30}?\\b(?:pass(?:es|ed)?|fail(?:s|ed)?|works?|worked|green|red)\\b|\\bthe\\s+host\\b(?!-|'s\\s+(?:name|key|address)|\\s+(?:names?|keys?|apps?|applications?|address(?:es)?|part|side|language|page|shell|program)\\b)",
        "unless_near": "\\b(?:mdns|avahi|dns|ssh|sshfs|urls?|uri|domains?|hostnames?|tailscale|mesh|peers?|lan|ip|dhcp|http|https)\\b",
        "allowed_when_changed": [
          "dev/sandbox*",
          "dev/rig*",
          "docs/internals/development.md",
          "test/test_sandbox.py"
        ],
        "quoted": true
      }
    ],
    "quoted_when_changed": [
      "dev/public-text-check",
      "dev/public-text-rules.json",
      "test/test_public_text.py"
    ]
  },
  "open_item": {
    "check": "open-item-no-owner",
    "markers": [
      {
        "id": "not-checked",
        "regex": "\\bnot\\s+(?:yet\\s+|been\\s+)?(?:checked|tested|covered|verified|driven)\\b",
        "unless_span": "^\\s*(?:>\\s*|(?:[-*+]|\\d+[.)])\\s+(?:\\[[ xX]\\]\\s+)?)*(?:\\*\\*)?Not\\s+verified:|not\\s+checked\\s+in\\s+a\\s+running\\s+shell"
      },
      {
        "id": "unchecked",
        "regex": "\\b(?:unchecked|untested|unverified)\\b"
      },
      {
        "id": "for-later",
        "regex": "\\bfor\\s+later\\b"
      },
      {
        "id": "follow-up",
        "regex": "\\bfollow-?\\s?ups?\\b"
      },
      {
        "id": "later",
        "unless_span": "\\b\\d+\\s*(?:ms|s|sec|min|h|days?)\\s+later\\b",
        "regex": "\\b(?:in|at|until|to|for)\\s+(?:a\\s+|the\\s+)?later\\b|\\blater\\s*(?:[.,;:)!?]|—|-\\s|$)|\\b(?:done|handled|fixed|checked|added|look(?:ed)?(?:\\s+at)?|decided?|do|dealt|revisit(?:ed)?|come\\s+back)\\s+(?:it\\s+|this\\s+)?later\\b"
      },
      {
        "id": "todo",
        "regex": "\\b(?:TODO|FIXME)\\b"
      },
      {
        "id": "out-of-scope",
        "regex": "\\bout\\s+of\\s+scope\\b"
      },
      {
        "id": "tracked-elsewhere",
        "regex": "\\btracked\\s+(?:separately|on\\s+its\\s+own\\s+issue)\\b"
      },
      {
        "id": "still-to",
        "regex": "\\bstill\\s+to\\b"
      },
      {
        "id": "does-not-block",
        "regex": "\\b(?:does\\s+not|doesn't|do\\s+not|don't|need\\s+not|would\\s+not|wouldn't|should\\s+not|shouldn't)\\s+block(?:\\s*(?:[:)—]|-\\s)|\\s+(?:the\\s+|this\\s+)?(?:merge|merging|pr|pull\\s+request|review|release|approval)\\b)"
      },
      {
        "id": "non-blocking",
        "regex": "(?:^\\s*(?:>\\s*)?(?:(?:[-*+]|\\d+[.)])\\s+)?(?:\\*\\*|_)?|[(\\[]\\s*|\\b(?:nits?|notes?|minor|optional)\\s*[,:(—-]\\s*)(?:non-?\\s?|not\\s+)blocking\\b|\\b(?:non-?\\s?|not\\s+)blocking(?:\\s*\\)|\\s+(?:notes?|nits?|findings?|suggestions?|observations?|comments?|issues?|remarks?|items?|points?|concerns?|for\\s+(?:the\\s+|this\\s+)?(?:merge|pr|pull\\s+request|review|release))\\b)"
      },
      {
        "id": "separate-change",
        "regex": "\\b(?:a|another|its\\s+own)\\s+separate\\s+(?:change|pr|pull\\s+request|issue|task|fix|branch)\\b|\\bin\\s+a\\s+separate\\s+(?:change|pr|pull\\s+request|fix|branch)\\b"
      },
      {
        "id": "left-for",
        "regex": "\\bleft\\s+for\\s+(?!(?:the\\s+)?(?:user|person|people)\\b)(?:the\\s+|a\\s+|an\\s+)?[\\w@-]+",
        "unless_span": "\\b(?:room|space|width|height|pixels?|px|time|seconds?|nothing|little|much|what(?:\\s+is)?)\\s+left\\s+for\\b"
      }
    ],
    "reference": "(?:[\\w.-]+/[\\w.-]+)?#\\d+|https?://github\\.com/[\\w.-]+/[\\w.-]+/(?:issues|pull)/\\d+"
  },
  "unlinked_reference": {
    "check": "unlinked-reference",
    "patterns": [
      {
        "id": "repo-without-owner",
        "regex": "(?<![\\w./-])[A-Za-z0-9][\\w.-]+#\\d+\\b"
      },
      {
        "id": "repo-without-owner",
        "regex": "`[\\w.-]+/[\\w.-]+`\\s*:?\\s*#\\d+\\b|(?<![\\w./`-])[\\w.-]+/[\\w.-]+:\\s*#\\d+\\b",
        "reads_code": true
      },
      {
        "id": "named-upstream-bare-number",
        "regex": "\\b(?:marketplace|upstream|omarchy|kde\\s?connect|kdeconnect|quickshell|hyprland)(?:'s)?\\s+(?:issue\\s+|pr\\s+|pull request\\s+)?#\\d+\\b"
      }
    ]
  },
  "standing": {
    "check": "standing-text-history",
    "files": [
      "AGENTS.md",
      "CLAUDE.md",
      ".claude/skills/**/*.md",
      "docs/internals/**/*.md"
    ],
    "patterns": [
      {
        "id": "task-id",
        "regex": "\\bSCE-\\d+\\b"
      },
      {
        "id": "date-as-history",
        "regex": "\\b20\\d\\d-\\d\\d-\\d\\d\\b"
      },
      {
        "id": "owner-said",
        "regex": "\\bthe owner(?:'s)? (?:said|decided|asked|decision|ask)\\b(?! (?:go|or no)\\b)"
      }
    ]
  },
  "public_files": {
    "files": ["CHANGELOG.md"],
    "pattern_ids": ["task-id", "paperclip", "home-path", "dot-path", "tmp-path", "test-count-passed", "test-count", "test-tally"]
  }
}
