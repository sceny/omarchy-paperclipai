#!/bin/bash
# Keep the owner's installed Sceny plugins on their repo's `develop` branch,
# with no agent run. One pass: for each plugin, fetch origin/develop,
# fast-forward the installed git checkout, validate it, roll back if the
# validation fails, and rescan the shell once if anything changed.
#
# Why not `omarchy plugin update`: it fetches the remote's default branch
# (`main`), and `main` is the release branch. It never brings `develop`.
#
#   follow-develop [run]      one pass (what the timer calls)
#   follow-develop install    copy this script to ~/.local/share/sceny-plugins/
#                             and enable the user timer (every 5 minutes)
#   follow-develop uninstall  disable the timer and remove what install made
#   follow-develop status     timer state and the last log lines
#
# Reusable: it takes plugin ids, not repos. Another Sceny plugin needs only its
# id added to FOLLOW_PLUGINS below (or in the environment).
#
# Blast radius: it only touches the checkouts named in FOLLOW_PLUGINS, and only
# when they are clean and on `develop`. A feature branch, local changes, a
# symlink or a non-git copy are left alone and logged. Never leave an install
# on a feature branch for a live check; use dev/rig.
#
# shellcheck shell=bash

set -uo pipefail

FOLLOW_PLUGINS=${FOLLOW_PLUGINS:-"sceny.devices sceny.paperclipai"}
FOLLOW_BRANCH=${FOLLOW_BRANCH:-develop}
PLUGINS_DIR=${FOLLOW_PLUGINS_DIR:-$HOME/.config/omarchy/plugins}
STATE_DIR=${FOLLOW_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/sceny-plugins}
LOG=$STATE_DIR/follow-develop.jsonl
INSTALL_DIR=${FOLLOW_INSTALL_DIR:-$HOME/.local/share/sceny-plugins}
UNIT_DIR=${FOLLOW_UNIT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}
UNIT=sceny-plugins-follow-develop
# Overridable so tests never reach a real shell.
VALIDATE_CMD=${FOLLOW_VALIDATE_CMD:-omarchy-plugin-validate}
RESCAN_CMD=${FOLLOW_RESCAN_CMD:-omarchy-shell shell rescanPlugins}

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

log() {
  # log <plugin> <result> [detail] [from] [to]; one JSON line, also on stdout.
  local line
  line=$(jq -nc --arg ts "$(date -u +%FT%TZ)" --arg plugin "$1" --arg result "$2" \
    --arg detail "${3:-}" --arg from "${4:-}" --arg to "${5:-}" \
    '{ts:$ts,plugin:$plugin,result:$result,detail:$detail,from:$from,to:$to}')
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$line" >>"$LOG"
  printf '%s\n' "$line"
}

follow_one() {
  local id=$1 dir=$PLUGINS_DIR/$1 branch old new
  if [[ -L $dir ]]; then log "$id" skipped "symlink to a working copy; left alone"; return 0; fi
  if [[ ! -d $dir ]]; then log "$id" skipped "not installed"; return 0; fi
  if [[ ! -d $dir/.git ]]; then log "$id" skipped "not a git checkout"; return 0; fi

  branch=$(git -C "$dir" symbolic-ref --quiet --short HEAD || true)
  if [[ $branch != "$FOLLOW_BRANCH" ]]; then
    log "$id" skipped "on '${branch:-detached HEAD}', not $FOLLOW_BRANCH"
    return 0
  fi
  if [[ -n $(git -C "$dir" status --porcelain --untracked-files=no) ]]; then
    log "$id" skipped "local changes in the checkout"
    return 0
  fi

  if ! git -C "$dir" fetch --quiet origin "$FOLLOW_BRANCH"; then
    log "$id" failed "fetch of origin/$FOLLOW_BRANCH failed"
    return 1
  fi
  old=$(git -C "$dir" rev-parse HEAD)
  new=$(git -C "$dir" rev-parse FETCH_HEAD)
  if [[ $old == "$new" ]]; then
    log "$id" up-to-date "" "$old" "$old"
    return 0
  fi
  if ! git -C "$dir" merge --ff-only --quiet FETCH_HEAD >/dev/null 2>&1; then
    log "$id" failed "cannot fast-forward to origin/$FOLLOW_BRANCH" "$old" "$new"
    return 1
  fi
  if ! $VALIDATE_CMD "$dir" >/dev/null 2>&1; then
    git -C "$dir" reset --hard --quiet "$old"
    log "$id" rolled-back "origin/$FOLLOW_BRANCH failed plugin validation" "$old" "$new"
    return 1
  fi
  log "$id" updated "" "$old" "$new"
  UPDATED=1
}

run() {
  local rc=0 id
  UPDATED=0
  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/follow-develop.lock"
  flock -n 9 || { log - skipped "another pass is running"; return 0; }
  for id in $FOLLOW_PLUGINS; do
    follow_one "$id" || rc=1
  done
  if ((UPDATED)); then
    # The shell may not be running (logged out); it reads plugins at start.
    if $RESCAN_CMD >/dev/null 2>&1; then
      log - rescanned
    else
      log - rescan-skipped "shell not reachable; it reads plugins when it starts"
    fi
  fi
  return $rc
}

install_units() {
  local src
  src=$(readlink -f "${BASH_SOURCE[0]}")
  mkdir -p "$INSTALL_DIR" "$UNIT_DIR"
  install -m 0755 "$src" "$INSTALL_DIR/follow-develop"
  cat >"$UNIT_DIR/$UNIT.service" <<EOF
[Unit]
Description=Fast-forward the installed Sceny plugins to their develop branch

[Service]
Type=oneshot
# One pass; one JSON line per plugin in ~/.local/state/sceny-plugins/follow-develop.jsonl
# (also in the journal under the identifier below).
ExecStart=$INSTALL_DIR/follow-develop run
SyslogIdentifier=sceny-plugins-follow-develop
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/usr/share/omarchy/bin
Environment=OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
TimeoutStartSec=3min
Nice=10
EOF
  cat >"$UNIT_DIR/$UNIT.timer" <<EOF
[Unit]
Description=Follow develop: bring the installed Sceny plugins up to date every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=$UNIT.service

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "$UNIT.timer"
}

uninstall_units() {
  systemctl --user disable --now "$UNIT.timer" 2>/dev/null || true
  rm -f "$UNIT_DIR/$UNIT.timer" "$UNIT_DIR/$UNIT.service" "$INSTALL_DIR/follow-develop"
  rmdir "$INSTALL_DIR" 2>/dev/null || true
  systemctl --user daemon-reload
}

status() {
  systemctl --user list-timers "$UNIT.timer" --no-pager 2>&1 | head -3
  echo
  tail -n 8 "$LOG" 2>/dev/null || echo "no log yet: $LOG"
}

case ${1:-run} in
  run) run ;;
  install) install_units ;;
  uninstall) uninstall_units ;;
  status) status ;;
  *) echo "usage: follow-develop [run|install|uninstall|status]" >&2; exit 2 ;;
esac
