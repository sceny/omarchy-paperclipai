#!/bin/bash
# Open Paperclip, or one task inside it.
#
# Usage:
#   omarchy-paperclip-open [--new-window] [url]
#
# The url decides what a click does:
#
#   * No url, or the board itself: raise the web app window that is already
#     open, and only start one when none is.
#   * A url inside the board (an issue, a run, an approval): open it in a web
#     app window of its own. A browser web app window takes no url from
#     outside once it runs, so raising the old window would leave the user on
#     whatever page it showed, and the click would seem to do nothing. The
#     browser maps the new window, so the compositor focuses it and the plugin
#     dispatches no focus (which warps the pointer to the window's middle).
#
# --new-window asks for a window of its own for any url, which is what the
# panel sends when you hold Shift. --focus is still accepted and means no flag.

set -uo pipefail

# shellcheck source=../lib/common.sh
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/lib/common.sh"

new_window=false
while [[ ${1:-} == -* ]]; do
  case $1 in
  --new-window | --new) new_window=true ;;
  --focus) ;;
  *)
    pc_fail "Unknown option: $1"
    exit 1
    ;;
  esac
  shift
done

url=${1:-}
[[ -n $url ]] || url=$(pc_api_base)

# Only a url on the instance's own origin (scheme, host and port) reaches a
# browser. A url from the API is data, not a command, and an app window has no
# address bar to show where a page really is. The base must be followed by the
# end, a path, a query or a fragment: never a userinfo, a longer host or port,
# or a backslash.
base=$(pc_api_base)
lower_url=${url,,}
lower_base=${base,,}
if [[ $lower_url != "$lower_base" ]]; then
  rest=${lower_url#"$lower_base"}
  if [[ $rest == "$lower_url" || ! $rest =~ ^[/?#] ]]; then
    pc_fail "Refusing to open a url outside the instance's own origin: $url"
    exit 1
  fi
fi

if [[ ${url%/} == "$base" ]]; then
  [[ $new_window == false ]] && pc_focus_webapp_window && exit 0
fi

if command -v omarchy-launch-webapp >/dev/null 2>&1; then
  exec omarchy-launch-webapp "$url"
fi

if command -v omarchy-launch-browser >/dev/null 2>&1; then
  exec omarchy-launch-browser "$url"
fi

exec xdg-open "$url"
