#!/bin/bash
# Repair the local Paperclip instance, with an agent in the room from the start.
#
# Usage:
#   omarchy-paperclip-doctor [--ask] [--yes] [--no-agent] [--bundle-only]
#   omarchy-paperclip-doctor --clear-failed [--older-than-days N] [--yes]
#
# What happens by default:
#   1. `paperclipai doctor --repair` starts in the background, and the
#      diagnosis bundle is collected behind it. Nothing waits for it.
#   2. An AI session opens at once, with the skills for this job loaded and
#      the background results in its own directory to read.
#   3. That session reads the evidence, says what it sees, and asks the user
#      what to fix. It can read logs, edit config and install packages — the
#      things a fixed list of repair steps cannot do.
#
# The built-in repair knows a handful of faults. The machine can be broken in
# ways no plugin can enumerate, so the plugin collects the evidence and calls
# someone in instead of guessing.
#
# --ask          ask in the terminal before the background repair starts
# --yes          never ask anything (the default, kept for callers)
# --no-agent     the old behaviour: repair in the foreground, no session
# --bundle-only  write the diagnosis bundle and stop
#
# --clear-failed clears failed-run rows that have sat in the inbox longer than
#                --older-than-days (7 by default) and stops. For a backlog
#                nobody is going to read row by row. It asks first, it only
#                ever touches failed-run rows, and every row it clears stays
#                recoverable: omarchy-paperclip-inbox restore --item-key ...

set -uo pipefail

# shellcheck source=../lib/common.sh
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/lib/common.sh"

ask=false
want_agent=true
bundle_only=false
background=false
clear_failed=false
assume_yes=false
older_than_days=7
session=""

while (($#)); do
  case $1 in
  --ask) ask=true ;;
  --yes | -y)
    ask=false
    assume_yes=true
    ;;
  --no-agent) want_agent=false ;;
  --clear-failed)
    clear_failed=true
    want_agent=false
    ;;
  --older-than-days)
    older_than_days=${2:?--older-than-days needs a number}
    shift
    ;;
  --bundle-only)
    bundle_only=true
    want_agent=false
    ;;
  # Set when this script re-invokes itself as the background worker.
  --background) background=true ;;
  --session-dir)
    session=${2:?--session-dir needs a path}
    shift
    ;;
  -h | --help)
    sed -n '2,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    pc_fail "Unknown option: $1"
    exit 1
    ;;
  esac
  shift
done

if [[ -z $session ]]; then
  session=$(pc_state_dir)/doctor-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$session"
fi
bundle=$session/bundle.log
log=$session/doctor.log
status_file=$session/doctor.status

keep_open() {
  [[ -t 0 ]] || return 0
  echo
  read -r -p "Press enter to close… " _ || true
}

section() {
  printf '\n===== %s =====\n' "$1" >>"$bundle"
}

collect() {
  # One readable file an agent (or a person) can start from.
  : >"$bundle"
  {
    echo "Paperclip doctor bundle"
    echo "generated: $(date -Is)"
    echo "plugin:    $PAPERCLIP_PLUGIN_ID ($PAPERCLIP_PLUGIN_DIR)"
    echo "instance:  $PAPERCLIP_INSTANCE"
    echo "api base:  $(pc_api_base)"
  } >>"$bundle"

  section "versions"
  {
    echo "node:    $(command -v node >/dev/null 2>&1 && node --version || echo missing)"
    echo "npm:     $(command -v npm >/dev/null 2>&1 && npm --version || echo missing)"
    echo "cli:     $(pc_cli | tr '\n' ' ')"
    echo "omarchy: $(cat "${OMARCHY_PATH:-/usr/share/omarchy}/version" 2>/dev/null || echo unknown)"
  } >>"$bundle" 2>&1

  section "status probe"
  python3 "$PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-status" >>"$bundle" 2>&1

  section "paperclipai doctor output"
  cat "$log" >>"$bundle" 2>/dev/null

  section "service"
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user status paperclipai.service --no-pager -n 20 >>"$bundle" 2>&1
    journalctl --user -u paperclipai.service -n 60 --no-pager >>"$bundle" 2>&1
  else
    echo "systemctl not available" >>"$bundle"
  fi

  section "instance files"
  ls -la "$HOME/.paperclip/instances/$PAPERCLIP_INSTANCE" >>"$bundle" 2>&1
  for file in "$HOME/.paperclip/instances/$PAPERCLIP_INSTANCE"/logs/*.log; do
    [[ -f $file ]] || continue
    echo "--- tail $file" >>"$bundle"
    tail -n 40 "$file" >>"$bundle" 2>&1
  done

  section "listening sockets"
  (ss -ltnp 2>/dev/null || netstat -ltnp 2>/dev/null) | grep -E "3100|LISTEN" >>"$bundle" 2>&1
}

print_status() {
  python3 "$PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-status" |
    jq -r '"   state:   \(.state)\n   summary: \(.summary)\n   problems: \((.problems // []) | if length == 0 then "none" else join("; ") end)"' 2>/dev/null
}

# ------------------------------------------------------------------ background
# The worker the session reads from. It repairs only what needs repairing, and
# writes one word to doctor.status so the session never has to parse a log to
# know whether it is finished.
if [[ $background == true ]]; then
  printf 'running\n' >"$status_file"

  if pc_health_ok; then
    echo "The instance was already answering on $(pc_api_base), so no repair was run." >"$log"
    collect
    printf 'healthy\n' >"$status_file"
    exit 0
  fi

  if [[ -z $(pc_cli) ]]; then
    echo "No Paperclip CLI and no npx, so there was nothing to run the repair with." >"$log"
    echo "Install Node.js 24.11 or newer, then: $PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-setup" >>"$log"
    collect
    printf 'no-cli\n' >"$status_file"
    exit 0
  fi

  pc_run_cli doctor --repair --yes >"$log" 2>&1

  if pc_wait_for_health 30; then
    collect
    printf 'fixed\n' >"$status_file"
    pc_notify normal "󰸞" "Paperclip repaired" "The instance is answering again." \
      --exec "$PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-open"
    exit 0
  fi

  collect
  printf 'still-broken\n' >"$status_file"
  exit 0
fi

# ----------------------------------------------------------------- bundle only
if [[ $bundle_only == true ]]; then
  collect
  pc_say "Diagnosis bundle: $bundle"
  keep_open
  exit 0
fi

# ------------------------------------------------------------- clear the backlog
# A hundred failed-run rows from a watchdog that looped for a week is not a
# list anybody is going to read. This clears the old ones and nothing else: no
# blockers, no questions, no reviews, and nothing newer than the cut-off.
if [[ $clear_failed == true ]]; then
  if ! pc_health_ok; then
    pc_fail "Paperclip is not answering on $(pc_api_base), so there is no inbox to clear."
    keep_open
    exit 1
  fi

  inbox=$PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-inbox
  mapfile -t companies < <(pc_status | jq -r '(.companies // [])[].id' 2>/dev/null)
  if ((${#companies[@]} == 0)); then
    pc_warn "No companies came back from the status probe."
    keep_open
    exit 1
  fi

  matched=0
  for company in "${companies[@]}"; do
    [[ -n $company ]] || continue
    found=$(python3 "$inbox" clear-failed --company "$company" \
      --older-than-days "$older_than_days" | jq -r '.matched // 0' 2>/dev/null)
    pc_say "$company: ${found:-0} failed-run rows older than $older_than_days days"
    matched=$((matched + ${found:-0}))
  done

  if ((matched == 0)); then
    pc_say "Nothing to clear."
    keep_open
    exit 0
  fi

  if [[ $assume_yes != true ]] && [[ -t 0 ]]; then
    read -r -p "Clear $matched failed-run rows? They stay recoverable. [y/N] " answer
    if [[ ${answer,,} != y* ]]; then
      pc_say "Left them alone."
      keep_open
      exit 0
    fi
  elif [[ $assume_yes != true ]]; then
    pc_warn "Nothing was cleared: this needs a terminal to ask in, or --yes."
    exit 1
  fi

  for company in "${companies[@]}"; do
    [[ -n $company ]] || continue
    python3 "$inbox" clear-failed --company "$company" \
      --older-than-days "$older_than_days" --apply |
      jq -r '"   \(.message)"' 2>/dev/null
  done
  pc_say "Undo one with: $inbox restore --company <id> --item-key <key>"
  keep_open
  exit 0
fi

echo
pc_say "Checking Paperclip…"
print_status

# ------------------------------------------------------------- no agent wanted
# The old behaviour, for a script or for anyone who wants no AI in this.
if [[ $want_agent != true ]]; then
  if [[ -z $(pc_cli) ]]; then
    pc_fail "No Paperclip CLI and no npx — there is nothing to run the repair with."
    pc_warn "Run setup first: $PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-setup"
    keep_open
    exit 1
  fi
  pc_say "Running paperclipai doctor --repair…"
  pc_run_cli doctor --repair --yes 2>&1 | tee "$log"
  if pc_wait_for_health 30; then
    pc_say "Paperclip is answering again on $(pc_api_base)."
    pc_notify normal "󰸞" "Paperclip repaired" "The instance is answering again." \
      --exec "$PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-open"
    keep_open
    exit 0
  fi
  pc_warn "Still not healthy after the built-in repair."
  collect
  pc_say "Diagnosis bundle: $bundle"
  keep_open
  exit 1
fi

# --------------------------------------------------------------- agent session
healthy=false
pc_health_ok && healthy=true

run_background=true
if [[ $ask == true ]] && [[ -t 0 ]] && [[ $healthy == false ]]; then
  read -r -p "Run 'paperclipai doctor --repair' in the background while the agent opens? [Y/n] " answer
  if [[ -n ${answer:-} && ${answer,,} != y* ]]; then
    run_background=false
  fi
fi

if [[ $run_background == true ]]; then
  if [[ $healthy == true ]]; then
    pc_say "Collecting the evidence in the background…"
  else
    pc_say "Running paperclipai doctor --repair in the background…"
  fi
  # Written here rather than in the worker, so a fast session never reads the
  # directory before the worker has had its first turn.
  printf 'running\n' >"$status_file"
  # setsid so closing this window later does not kill the repair, and so the
  # worker outlives the exec into the agent below.
  setsid "${BASH_SOURCE[0]}" --background --session-dir "$session" \
    >"$session/background.out" 2>&1 &
  disown 2>/dev/null || true
else
  printf 'skipped\n' >"$status_file"
  echo "The user declined the built-in repair, so none of it ran." >"$log"
  pc_say "Left the built-in repair alone."
fi

{
  echo "My Paperclip instance needs attention and I opened you from the Paperclip bar widget."
  echo
  echo "Read AGENTS.md in this directory first, and use the paperclip-doctor skill."
  echo
  echo "If the inbox is full of old failed-run rows and that is the complaint, this"
  echo "clears the ones older than seven days and nothing else, after asking:"
  echo "  $PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-doctor --clear-failed"
  echo "Every row it clears is recoverable with omarchy-paperclip-inbox restore."
  echo
  if [[ $run_background == true ]]; then
    if [[ $healthy == true ]]; then
      echo "Paperclip is answering right now. A diagnosis bundle is being collected in"
      echo "the background anyway, so there is evidence to read."
    else
      echo "'paperclipai doctor --repair' is running in the background right now. It may"
      echo "fix this on its own, and it may not."
    fi
    echo
    echo "The result lands in these files, in this directory:"
    echo "  ./doctor.status  one word: running, fixed, still-broken, healthy or no-cli"
    echo "  ./doctor.log     what the built-in repair printed"
    echo "  ./bundle.log     versions, status probe, service state, logs, sockets"
    echo
    echo "Do this in order:"
    echo "  1. Read ./doctor.status, then ./bundle.log."
    echo "  2. If the status is still 'running', wait a few seconds and read it again."
    echo "  3. Tell me in two or three lines what state Paperclip is in."
    echo "  4. Ask me what you should fix, and wait for my answer before you change anything."
  else
    echo "I did not want the built-in repair to run, so it did not."
    echo
    echo "Do this in order:"
    echo "  1. Run the status probe: $PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-status"
    echo "  2. Tell me in two or three lines what state Paperclip is in."
    echo "  3. Ask me what you should fix, and wait for my answer before you change anything."
  fi
} >"$session/prompt.txt"

# Inline when this script already owns a terminal window, which is how the bar
# widget starts it. Otherwise the agent opens its own window — a notification
# action has none to lend.
inline=()
[[ -t 1 ]] && inline=(--inline)

if ! "$PAPERCLIP_PLUGIN_DIR/bin/omarchy-paperclip-agent" "${inline[@]}" \
  --session-dir "$session" --prompt-file "$session/prompt.txt"; then
  pc_warn "No agent session opened. The evidence is here: $session"
  keep_open
  exit 1
fi
